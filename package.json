{
  "name": "focuslab",
  "private": true,
  "version": "1.0.0",
  "description": "FocusLab \u2014 a science-based attention training & deep-work app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "i18n": "node scripts/i18n-extract.mjs --write && node scripts/i18n-hant.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "opencc-js": "^1.4.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
